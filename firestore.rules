rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can only read/write their own data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Wardrobe items - users can only access their own items
    match /wardrobe_items/{itemId} {
      allow read: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      // For create/update, check the incoming data
      allow create, update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      // For delete, check the existing data (resource)
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
    
    // Style personas - users can only access their own personas
    match /style_personas/{personaId} {
      allow read: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
    
    // Trends - read-only for authenticated users
    match /trends/{trendId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Recommendations - read-only for the owner
    match /recommendations/{recommendationId} {
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
